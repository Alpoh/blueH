<UserControl x:Class="BlueH.Views.DeviceHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BlueH.Converters">
    <UserControl.Resources>
        <converters:DeviceKindToGlyphConverter x:Key="DeviceKindToGlyph" />
        <converters:ConnectionStateToTextConverter x:Key="ConnectionStateToText" />
        <converters:BatteryChargeToTextConverter x:Key="BatteryChargeToText" />
        <converters:BatteryChargeToGlyphConverter x:Key="BatteryChargeToGlyph" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource SectionMargin}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Device.Kind, Converter={StaticResource DeviceKindToGlyph}}"
                           Style="{StaticResource HeroIconStyle}"
                           Margin="{StaticResource DeviceIconMargin}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource ConnectionDotStyle}" Margin="{StaticResource StatusDotMargin}" />
                        <TextBlock Text="{Binding Device.IsConnected, Converter={StaticResource ConnectionStateToText}}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="{StaticResource TightStackedItemMargin}"
                                Visibility="{Binding Device.Battery.IsKnown, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="{Binding Device.Battery, Converter={StaticResource BatteryChargeToGlyph}}"
                                   Style="{StaticResource IconTextStyle}"
                                   Margin="{StaticResource StatusDotMargin}" />
                        <TextBlock Text="{Binding Device.Battery, Converter={StaticResource BatteryChargeToText}}"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding BatteryNotReportedText}"
                               Style="{StaticResource SecondaryCaptionTextStyle}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource TightStackedItemMargin}"
                               Visibility="{Binding Device.Battery.IsKnown, Converter={StaticResource InverseBooleanToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding CancelLabel}"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"
                            Margin="{StaticResource InlineItemMargin}" />
                    <Button Content="{Binding ConnectLabel}"
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibility}}" />
                    <Button Content="{Binding DisconnectLabel}"
                            Command="{Binding DisconnectCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource StackedItemTopMargin}"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
