<UserControl x:Class="BlueH.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Grid.IsSharedSizeScope="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="DiagnosticsTime" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="DiagnosticsOutcome" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="DiagnosticsOperation" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TimeHeader}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,16,0" />
            <TextBlock Grid.Column="1" Text="{Binding OutcomeHeader}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,16,0" />
            <TextBlock Grid.Column="2" Text="{Binding OperationHeader}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,16,0" />
            <TextBlock Grid.Column="3" Text="{Binding DetailHeader}" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>
        <ListBox ItemsSource="{Binding Entries}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="DiagnosticsTime" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="DiagnosticsOutcome" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="DiagnosticsOperation" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RecordedAtText}" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Outcome}" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Operation}" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
