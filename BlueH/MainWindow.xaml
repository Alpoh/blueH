<Window x:Class="BlueH.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BlueH.Views"
        Height="640" Width="880" MinHeight="360" MinWidth="520">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="120" />
        </Grid.RowDefinitions>
        <views:DevicesView Grid.Row="0" DataContext="{Binding Devices}" />
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />
        <views:DiagnosticsView Grid.Row="2" DataContext="{Binding Diagnostics}" />
    </Grid>
</Window>
