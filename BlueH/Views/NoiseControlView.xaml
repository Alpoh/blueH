<UserControl x:Class="BlueH.Views.NoiseControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <StackPanel Visibility="{Binding IsShown, Converter={StaticResource BooleanToVisibility}}"
                Margin="{StaticResource SectionMargin}">
        <TextBlock Text="{Binding Header}"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   Margin="{StaticResource SectionHeaderMargin}" />
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <StackPanel Visibility="{Binding IsConnecting, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding ConnectingMessage}"
                               Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Margin="{StaticResource StackedItemTopMargin}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Options}"
                              Visibility="{Binding IsReady, Converter={StaticResource BooleanToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Label}"
                                         GroupName="NoiseControlMode"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding SelectCommand}"
                                         Margin="{StaticResource WrappedButtonMargin}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding UnknownModeMessage}"
                           Style="{StaticResource SecondaryCaptionTextStyle}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsModeUnknown, Converter={StaticResource BooleanToVisibility}}"
                           Margin="{StaticResource StackedItemTopMargin}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibility}}"
                           Margin="{StaticResource StackedItemTopMargin}" />
                <Button Content="{Binding RetryLabel}"
                        Command="{Binding RetryCommand}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibility}}"
                        Margin="{StaticResource StackedItemTopMargin}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
