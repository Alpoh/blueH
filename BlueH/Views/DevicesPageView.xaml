<UserControl x:Class="BlueH.Views.DevicesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BlueH.Views"
             xmlns:themes="clr-namespace:BlueH.Themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource ScrollContentMargin}">
            <Button Command="{Binding AddDeviceCommand}"
                    AutomationProperties.Name="{Binding AddDeviceLabel}"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource SectionHeaderMargin}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static themes:Glyphs.Add}"
                               Style="{StaticResource IconTextStyle}"
                               Margin="{StaticResource StatusDotMargin}" />
                    <TextBlock Text="{Binding AddDeviceLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <views:DevicesView DataContext="{Binding Devices}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
