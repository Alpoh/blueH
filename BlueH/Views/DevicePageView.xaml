<UserControl x:Class="BlueH.Views.DevicePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BlueH.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <views:SelectedDeviceView DataContext="{Binding Device}" />
            <views:EndpointsView DataContext="{Binding Outputs}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
