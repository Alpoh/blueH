<UserControl x:Class="BlueH.Views.EndpointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:BlueH.Behaviors"
             xmlns:converters="clr-namespace:BlueH.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
    </UserControl.Resources>
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Header}"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding EmptyMessage}"
                   Visibility="{Binding HasNoEndpoints, Converter={StaticResource BooleanToVisibility}}"
                   TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Endpoints}" HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{Binding DataContext.DefaultForPlaybackLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Visibility="{Binding IsDefaultForPlayback, Converter={StaticResource BooleanToVisibility}}"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Margin="12,0,0,0" />
                                <TextBlock Text="{Binding DataContext.DefaultForCommunicationsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Visibility="{Binding IsDefaultForCommunications, Converter={StaticResource BooleanToVisibility}}"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding DataContext.VolumeHeader, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Slider Value="{Binding VolumePercent, Mode=TwoWay}"
                                        Minimum="0"
                                        Maximum="100"
                                        Width="220"
                                        VerticalAlignment="Center" />
                                <Grid MinWidth="56" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VolumePercent}"
                                               ToolTip="{Binding DataContext.VolumeEditHint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Visibility="{Binding IsEditingVolume, Converter={StaticResource InverseBooleanToVisibility}}"
                                               Background="Transparent"
                                               VerticalAlignment="Center">
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding BeginEditVolumeCommand}" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <TextBox Text="{Binding VolumeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             Visibility="{Binding IsEditingVolume, Converter={StaticResource BooleanToVisibility}}"
                                             behaviors:FocusWhenVisible.IsEnabled="True"
                                             LostFocus="VolumeInputLostFocus"
                                             VerticalAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <Trigger Property="Validation.HasError" Value="True">
                                                        <Setter Property="ToolTip"
                                                                Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding CommitVolumeInputCommand}" />
                                            <KeyBinding Key="Escape" Command="{Binding CancelVolumeEditCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>
                                <ToggleButton Content="{Binding DataContext.MuteLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              IsChecked="{Binding IsMuted, Mode=OneWay}"
                                              Command="{Binding ToggleMuteCommand}"
                                              Margin="16,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{Binding DataContext.MakeDefaultForPlaybackLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Command="{Binding MakeDefaultForPlaybackCommand}" />
                                <Button Content="{Binding DataContext.MakeDefaultForCommunicationsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Command="{Binding MakeDefaultForCommunicationsCommand}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
