<UserControl x:Class="BlueH.Views.DevicePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BlueH.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource ScrollContentMargin}">
            <views:DeviceHeaderView DataContext="{Binding Device}" />
            <TextBlock Text="{Binding OutputsHeader}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="{StaticResource SectionHeaderMargin}" />
            <views:EndpointsView DataContext="{Binding Outputs}" Margin="{StaticResource SectionMargin}" />
            <views:DeviceRemovalView DataContext="{Binding Device}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
