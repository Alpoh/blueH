<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Double x:Key="SpacingExtraSmall">4</sys:Double>
    <sys:Double x:Key="SpacingSmall">8</sys:Double>
    <sys:Double x:Key="SpacingMedium">12</sys:Double>
    <sys:Double x:Key="SpacingLarge">16</sys:Double>
    <sys:Double x:Key="SpacingExtraLarge">24</sys:Double>

    <Thickness x:Key="PagePadding">24,16,24,16</Thickness>
    <Thickness x:Key="SectionMargin">0,0,0,24</Thickness>
    <Thickness x:Key="SectionHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="CardPadding">16,12,16,12</Thickness>
    <Thickness x:Key="StackedItemMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TightStackedItemMargin">0,2,0,0</Thickness>
    <Thickness x:Key="InlineItemMargin">0,0,8,0</Thickness>
    <Thickness x:Key="WrappedButtonMargin">0,0,8,4</Thickness>
    <Thickness x:Key="ColumnGapMargin">0,0,16,0</Thickness>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
</ResourceDictionary>
