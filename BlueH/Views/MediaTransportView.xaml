<UserControl x:Class="BlueH.Views.MediaTransportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <StackPanel Margin="12">
        <TextBlock Text="{Binding Header}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <TextBlock Text="{Binding NoSessionMessage}"
                   Visibility="{Binding HasNoSession, Converter={StaticResource BooleanToVisibility}}"
                   TextWrapping="Wrap" />
        <StackPanel Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Visibility="{Binding HasSession, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ArtistText}" TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock Text="{Binding SourceAppId}" Opacity="0.7" Margin="0,2,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{Binding PreviousLabel}" Command="{Binding SkipPreviousCommand}" />
                <Button Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" Margin="8,0,0,0" />
                <Button Content="{Binding NextLabel}" Command="{Binding SkipNextCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
