<Window x:Class="BlueH.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BlueH.Views"
        Height="860" Width="920" MinHeight="420" MinWidth="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="100" />
        </Grid.RowDefinitions>
        <views:DevicesView Grid.Row="0" DataContext="{Binding Devices}" />
        <views:MediaTransportView Grid.Row="1" DataContext="{Binding MediaTransport}" />
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" />
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <views:EndpointsView DataContext="{Binding Endpoints}" />
        </ScrollViewer>
        <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch" />
        <views:DiagnosticsView Grid.Row="5" DataContext="{Binding Diagnostics}" />
    </Grid>
</Window>
