<UserControl x:Class="BlueH.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:BlueH.Themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource ScrollContentMargin}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource StackedItemMargin}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="{StaticResource ColumnGapMargin}">
                            <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding LanguageDescription}"
                                       Style="{StaticResource SecondaryCaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource TightStackedItemMargin}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="{Binding LanguageLabel}"
                                  MinWidth="200"
                                  VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding RestartRequiredMessage}"
                               Visibility="{Binding IsRestartRequired, Converter={StaticResource BooleanToVisibility}}"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource StackedItemTopMargin}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource StackedItemMargin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="{StaticResource ColumnGapMargin}">
                        <TextBlock Text="{Binding DeveloperModeLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding DeveloperModeDescription}"
                                   Style="{StaticResource SecondaryCaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="{StaticResource TightStackedItemMargin}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsDeveloperModeEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding DeveloperModeLabel}"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource StackedItemMargin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="{StaticResource ColumnGapMargin}">
                        <TextBlock Text="{Binding WidgetTopmostLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding WidgetTopmostDescription}"
                                   Style="{StaticResource SecondaryCaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="{StaticResource TightStackedItemMargin}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsWidgetTopmost, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding WidgetTopmostLabel}"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}"
                    Margin="{StaticResource StackedItemMargin}">
                <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="{Binding AboutHeader}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="{StaticResource SpacedSectionHeaderMargin}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static themes:Glyphs.Headphones}"
                               Style="{StaticResource DeviceIconStyle}"
                               VerticalAlignment="Top"
                               Margin="{StaticResource DeviceIconMargin}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding ApplicationName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding VersionText}"
                                   Style="{StaticResource SecondaryCaptionTextStyle}"
                                   Margin="{StaticResource TightStackedItemMargin}" />
                        <TextBlock Text="{Binding CreditText}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="{StaticResource StackedItemTopMargin}" />
                        <TextBlock Margin="{StaticResource TightStackedItemMargin}">
                            <Hyperlink Command="{Binding OpenCreditLinkCommand}">
                                <Run Text="{Binding CreditLinkLabel, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
