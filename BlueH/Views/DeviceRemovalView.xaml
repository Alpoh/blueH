<UserControl x:Class="BlueH.Views.DeviceRemovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BlueH.Converters">
    <UserControl.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource SectionMargin}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="{StaticResource ColumnGapMargin}">
                    <TextBlock Text="{Binding RemovalHeader}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{Binding RemovalDescription}"
                               Style="{StaticResource SecondaryCaptionTextStyle}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource TightStackedItemMargin}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding UnpairLabel}"
                        Command="{Binding UnpairCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsConfirmingUnpair, Converter={StaticResource InverseBooleanToVisibility}}" />
            </Grid>
            <StackPanel Visibility="{Binding IsConfirmingUnpair, Converter={StaticResource BooleanToVisibility}}"
                        Margin="{StaticResource StackedItemTopMargin}">
                <TextBlock Text="{Binding UnpairConfirmationText}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource StackedItemMargin}" />
                <WrapPanel>
                    <Button Content="{Binding ConfirmUnpairLabel}"
                            Command="{Binding ConfirmUnpairCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="{StaticResource InlineItemMargin}" />
                    <Button Content="{Binding CancelLabel}" Command="{Binding CancelUnpairCommand}" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
