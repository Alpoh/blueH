<Window x:Class="BlueH.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BlueH.Views"
        xmlns:pages="clr-namespace:BlueH.ViewModels.Pages"
        xmlns:themes="clr-namespace:BlueH.Themes"
        Icon="/Assets/BlueH.ico"
        Height="760" Width="1000" MinHeight="480" MinWidth="720">
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding Navigator.GoBackCommand}" />
        <KeyBinding Key="BrowserBack" Command="{Binding Navigator.GoBackCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <DataTemplate DataType="{x:Type pages:DevicesPageViewModel}">
            <views:DevicesPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:AddDevicePageViewModel}">
            <views:AddDevicePageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:DevicePageViewModel}">
            <views:DevicePageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:AudioPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <views:EndpointsView DataContext="{Binding Outputs}" Margin="{StaticResource ScrollContentMargin}" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
            <views:SettingsView DataContext="{Binding Settings}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:DiagnosticsPageViewModel}">
            <views:DiagnosticsView DataContext="{Binding Diagnostics}" />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox Grid.Row="0"
                 Grid.Column="0"
                 ItemsSource="{Binding MenuItems}"
                 SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource NavigationItemStyle}"
                 MinWidth="200"
                 Margin="{StaticResource ShellRailMargin}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconTextStyle}" Margin="{StaticResource NavigationIconMargin}" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="0" Grid.Column="1" Margin="{StaticResource PagePadding}">
            <DockPanel DockPanel.Dock="Top" Margin="{StaticResource SectionHeaderMargin}">
                <Button DockPanel.Dock="Right"
                        Content="{x:Static themes:Glyphs.SwitchToWidget}"
                        Command="{Binding DisplayMode.SwitchToWidgetCommand}"
                        ToolTip="{Binding DisplayMode.SwitchToWidgetLabel}"
                        AutomationProperties.Name="{Binding DisplayMode.SwitchToWidgetLabel}"
                        Style="{StaticResource IconButtonStyle}"
                        VerticalAlignment="Center" />
                <Button Content="{x:Static themes:Glyphs.Back}"
                        Command="{Binding Navigator.GoBackCommand}"
                        Visibility="{Binding Navigator.CanGoBack, Converter={StaticResource BooleanToVisibility}}"
                        ToolTip="{Binding BackLabel}"
                        AutomationProperties.Name="{Binding BackLabel}"
                        Style="{StaticResource IconButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="{StaticResource NavigationIconMargin}" />
                <TextBlock Text="{Binding Navigator.CurrentPage.Title}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ContentControl Content="{Binding Navigator.CurrentPage}" Focusable="False" />
        </DockPanel>
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource CardBorderStyle}"
                Margin="{StaticResource MiniPlayerMargin}">
            <views:MediaTransportView DataContext="{Binding MediaTransport}" />
        </Border>
    </Grid>
</Window>
