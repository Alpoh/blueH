<UserControl x:Class="BlueH.Views.MediaTransportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:BlueH.Themes"
             xmlns:converters="clr-namespace:BlueH.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
        <converters:ImageBytesToImageSourceConverter x:Key="ImageBytesToImageSource" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Style="{StaticResource ArtworkFrameStyle}"
                Visibility="{Binding HasSession, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
                <TextBlock Text="{Binding ArtworkPlaceholderGlyph}"
                           Style="{StaticResource ArtworkPlaceholderStyle}"
                           Visibility="{Binding HasArtwork, Converter={StaticResource InverseBooleanToVisibility}}" />
                <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                        Visibility="{Binding HasArtwork, Converter={StaticResource BooleanToVisibility}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork, Converter={StaticResource ImageBytesToImageSource}}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource ColumnGapMargin}">
            <TextBlock Text="{Binding NoSessionMessage}"
                       Visibility="{Binding HasNoSession, Converter={StaticResource BooleanToVisibility}}"
                       Style="{StaticResource SecondaryTextStyle}" />
            <StackPanel Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ErrorDetail}" Style="{StaticResource SecondaryCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Visibility="{Binding HasSession, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding TitleText}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ArtistText}" Style="{StaticResource SecondaryCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasSession, Converter={StaticResource BooleanToVisibility}}">
            <Button Content="{x:Static themes:Glyphs.Previous}"
                    Command="{Binding SkipPreviousCommand}"
                    ToolTip="{Binding PreviousLabel}"
                    AutomationProperties.Name="{Binding PreviousLabel}"
                    Style="{StaticResource IconButtonStyle}"
                    Margin="{StaticResource InlineItemMargin}" />
            <Button Content="{Binding PlayPauseGlyph}"
                    Command="{Binding PlayPauseCommand}"
                    ToolTip="{Binding PlayPauseLabel}"
                    AutomationProperties.Name="{Binding PlayPauseLabel}"
                    Style="{StaticResource IconButtonStyle}"
                    Margin="{StaticResource InlineItemMargin}" />
            <Button Content="{x:Static themes:Glyphs.Next}"
                    Command="{Binding SkipNextCommand}"
                    ToolTip="{Binding NextLabel}"
                    AutomationProperties.Name="{Binding NextLabel}"
                    Style="{StaticResource IconButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
