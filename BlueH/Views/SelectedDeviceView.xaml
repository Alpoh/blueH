<UserControl x:Class="BlueH.Views.SelectedDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <StackPanel Margin="12,0,12,8">
        <TextBlock Text="{Binding NoDeviceMessage}"
                   Visibility="{Binding HasNoDevice, Converter={StaticResource BooleanToVisibility}}"
                   Opacity="0.7"
                   TextWrapping="Wrap" />
        <StackPanel Visibility="{Binding HasDevice, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="{Binding Device.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <WrapPanel Margin="0,6,0,0">
                <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" Margin="0,0,8,4" />
                <Button Content="{Binding DisconnectLabel}" Command="{Binding DisconnectCommand}" Margin="0,0,8,4" />
                <Button Content="{Binding UnpairLabel}" Command="{Binding UnpairCommand}" Margin="0,0,8,4" />
                <Button Content="{Binding CancelLabel}"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"
                        Margin="0,0,8,4" />
            </WrapPanel>
            <StackPanel Visibility="{Binding IsConfirmingUnpair, Converter={StaticResource BooleanToVisibility}}"
                        Margin="0,4,0,0">
                <TextBlock Text="{Binding UnpairConfirmationText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="{Binding ConfirmUnpairLabel}" Command="{Binding ConfirmUnpairCommand}" Margin="0,0,8,0" />
                    <Button Content="{Binding CancelLabel}" Command="{Binding CancelUnpairCommand}" />
                </WrapPanel>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
