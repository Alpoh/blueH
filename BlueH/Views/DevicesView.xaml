<UserControl x:Class="BlueH.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BlueH.Converters"
             xmlns:themes="clr-namespace:BlueH.Themes"
             xmlns:views="clr-namespace:BlueH.Views">
    <UserControl.Resources>
        <converters:DeviceKindToGlyphConverter x:Key="DeviceKindToGlyph" />
        <converters:ConnectionStateToTextConverter x:Key="ConnectionStateToText" />
        <converters:BatteryChargeToTextConverter x:Key="BatteryChargeToText" />
        <converters:BatteryChargeToGlyphConverter x:Key="BatteryChargeToGlyph" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Visibility="{Binding HasNoDevices, Converter={StaticResource BooleanToVisibility}}"
                    Margin="{StaticResource EmptyStateMargin}">
            <TextBlock Text="{x:Static themes:Glyphs.Bluetooth}" Style="{StaticResource EmptyStateIconStyle}" />
            <TextBlock Text="{Binding EmptyMessage}"
                       Style="{StaticResource SecondaryTextStyle}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="{StaticResource StackedItemTopMargin}" />
            <Button Content="{Binding DataContext.AddDeviceLabel, RelativeSource={RelativeSource AncestorType=views:DevicesPageView}}"
                    Command="{Binding DataContext.AddDeviceCommand, RelativeSource={RelativeSource AncestorType=views:DevicesPageView}}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="{StaticResource StackedItemTopMargin}" />
        </StackPanel>
        <Border Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}"
                Style="{StaticResource CardBorderStyle}"
                Margin="{StaticResource StackedItemMargin}">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorDetail}"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource TightStackedItemMargin}" />
            </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding ContainerId}"
                            AutomationProperties.Name="{Binding Name}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="{StaticResource CardPadding}"
                            Margin="{StaticResource StackedItemMargin}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Kind, Converter={StaticResource DeviceKindToGlyph}}"
                                       Style="{StaticResource DeviceIconStyle}"
                                       Margin="{StaticResource DeviceIconMargin}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="{StaticResource TightStackedItemMargin}">
                                    <Ellipse Style="{StaticResource ConnectionDotStyle}" Margin="{StaticResource StatusDotMargin}" />
                                    <TextBlock Text="{Binding IsConnected, Converter={StaticResource ConnectionStateToText}}"
                                               Style="{StaticResource SecondaryCaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Battery.IsKnown, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock Text="{Binding Battery, Converter={StaticResource BatteryChargeToGlyph}}"
                                               Style="{StaticResource IconTextStyle}"
                                               Margin="{StaticResource StatusDotMargin}" />
                                    <TextBlock Text="{Binding Battery, Converter={StaticResource BatteryChargeToText}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding DataContext.BatteryUnknownShortLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           ToolTip="{Binding DataContext.BatteryUnknownTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Visibility="{Binding Battery.IsKnown, Converter={StaticResource InverseBooleanToVisibility}}"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center" />
                                <Button Content="{Binding DataContext.ConnectLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Command="{Binding DataContext.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ContainerId}"
                                        Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibility}}"
                                        Margin="{StaticResource CardActionMargin}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
